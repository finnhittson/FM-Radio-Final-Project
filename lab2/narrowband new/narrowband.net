* C:\Users\pig\Documents\ee251\lab2\narrowband new\narrowband.asc
L1 N001 N002 100n
C1 N001 out 25p
XQ1 N002 N003 0 X2SC2753
V3 N001 0 12
R6 N003 0 680
R2 N001 N002 70
R1 N004 N003 1.5k
R3 N002 N004 1.5k
C2 N004 0 10n
C3 N003 in 52.2p
L2 in 0 82.2n
V1 in 0 AC 1 Rser=50
C5 out N002 350p
R5 out 0 50
.lib 2SC2753.sub
.ac dec 100 1Meg 10Giga
.net I(R5) V1
* .meas ac Zin_mag FIND 10**(MAG(V(out)/I(I1))/20) WHEN freq={f}
* .meas ac Zin_phase FIND V(out)/I(I1) WHEN freq={f}
.param f=98Meg
.backanno
.end
